# ---------- copy this file to .env and change the values ----------

# Key that every client must send in the X-API-Key header. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=xQ_gfaySl0ankq8Ca2hkm7gN5Bp3lQHFIwZCsv1aYpU

# Secret used to sign login tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ZmHIv23aywgdK2bGXUGg9yuFkPVwCEamAMJwWTbVlVciRfA8iSSb8Po9rAqWLCRR

# AES-256 keys for patient data, format  version:base64key  (comma separated).
# Generate a key with:
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEYS=1:qctKNUEZB0YgqzAUDf3Hs711QOQYLRFs3kSgqOB3V3U=
# Which key version is used for NEW data (to rotate: add key 2, set this to 2, run rotate_keys.py)
ACTIVE_KEY_VERSION=1

# ---------- optional (defaults shown) ----------
# DATABASE_URL=sqlite:///ncare.db
# TOKEN_EXPIRE_MINUTES=60
# MAX_FAILED_ATTEMPTS=5
# LOCKOUT_MINUTES=15
# LOGIN_RATE_LIMIT=10/minute
# DEMO_PASSWORD=Demo@1234
# MAX_UPLOAD_MB=10
# MAX_UPLOAD_ROWS=10000
# COOKIE_SECURE=false          # set true when serving over https
# FRONTEND_URL=http://localhost:5173

# ---------- used by docker compose only (PostgreSQL) ----------
POSTGRES_USER=ncare
POSTGRES_PASSWORD=ncare_password
POSTGRES_DB=ncare
